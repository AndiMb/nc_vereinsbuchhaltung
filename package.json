{
	"name": "vereinsbuchhaltung",
	"description": "Vereinsbuchhaltung für Nextcloud",
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"scripts": {
		"build": "webpack --node-env production --progress",
		"dev": "webpack --node-env development --progress",
		"watch": "webpack --node-env development --progress --watch",
		"lint": "eslint src/",
		"stylelint": "stylelint \"src/**/*.{vue,css}\"",
		"test": "vitest run",
		"test:e2e:server": "node tests/e2e/setup/server.mjs",
		"test:e2e:server-stop": "node tests/e2e/setup/server.mjs --stop",
		"test:e2e": "npm run test:e2e:server && npm run test:e2e:run",
		"test:e2e:run": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:install": "playwright install --with-deps chromium"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@nextcloud/axios": "^2.5.0",
		"@nextcloud/dialogs": "^7.4.1",
		"@nextcloud/l10n": "^3.4.1",
		"@nextcloud/router": "^3.1.0",
		"@nextcloud/vue": "^9.10.0",
		"chart.js": "^4.5.1",
		"vue": "^3.5.18"
	},
	"devDependencies": {
		"@nextcloud/babel-config": "^1.3.0",
		"@nextcloud/browserslist-config": "^3.1.2",
		"@nextcloud/e2e-test-server": "^0.5.1",
		"@nextcloud/eslint-config": "^9.0.1",
		"@playwright/test": "^1.62.1",
		"@nextcloud/stylelint-config": "^3.2.2",
		"@nextcloud/webpack-vue-config": "^7.0.4",
		"eslint": "^10.9.1",
		"vitest": "^4.1.11",
		"vue-loader": "^17.4.2"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
	],
	"engines": {
		"node": "^22.0.0 || ^24.0.0",
		"npm": "^10.0.0 || ^11.0.0"
	}
}
