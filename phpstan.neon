# Statische Analyse des PHP-Anteils.
#
# Die Nextcloud-Server-Schnittstellen (OCP\*) liegen nicht im Repository. Sie
# werden fuer die Analyse als eigenes composer-Projekt unter .phpstan/ geholt
# (siehe .phpstan/composer.json und den CI-Schritt in .github/workflows/ci.yml).
# Bewusst getrennt von der composer.json der App: die bleibt ohne Abhaengigkeiten,
# damit im Release-Tarball kein Fremdcode landet.
#
# Lokal:  composer install --working-dir=.phpstan && .phpstan/vendor/bin/phpstan analyse
#
# .phpstan/composer.json bleibt bewusst auf nextcloud/ocp ^30.0, obwohl
# appinfo/info.xml seit der Vue-3-Migration (0.23.0) NC >=31 verlangt: die
# Stub-Version hier ist unabhaengig von der deklarierten NC-Mindestversion
# der App und beeinflusst nicht, welche Server die App tatsaechlich laden.
#
# Ein Versuch, hier auf ^31.0 zu heben, fuehrte auf eine davon unabhaengige
# Spur (Issue #2): gegen dieselben v30-Stubs meldeten PHPStan 2.1.14 bis
# 2.2.1 rund 205-206 argument.type-Fehler bei generischen DataResponse<T>
# (der bestehende Controller-Code liefert ueberall unspezifische
# Arrays/Entities). Per `git stash` gegen den unveraenderten main-Branch und
# Bisektion ueber mehrere PHPStan-Versionen verifiziert (Stand 22.08.2026):
# ein PHPStan-eigener Regressionsbug in der Generics-Aufloesung, nicht ein
# echtes Typproblem im Code - ab 2.2.5 liefert derselbe Code 0 Fehler. Behoben
# durch Pinnen von phpstan/phpstan auf ^2.2.5 in .phpstan/composer.json,
# per composer.lock reproduzierbar sowohl lokal als auch in CI (die vorher
# genutzte setup-php-'tools:'-Installation zog dagegen bei jedem CI-Lauf
# unversioniert die jeweils neueste PHPStan-Version).
parameters:
	level: 5
	paths:
		- lib
		- tests

	# Das ganze vendor-Verzeichnis, nicht nur nextcloud/ocp: psr/log kommt als
	# Abhaengigkeit der OCP-Stubs mit und wird von WatchFolderService gebraucht.
	scanDirectories:
		- .phpstan/vendor

	# Die Migrationen beschreiben einen vergangenen Zustand und werden nicht
	# mehr angefasst; ihre Schema-Closures sind fuer PHPStan ohnehin undurchsichtig.
	excludePaths:
		analyse:
			- lib/Migration

	# QBMapper::insert()/update() sind im Server generisch ueber @template
	# annotiert, in den Stubs aber nur als Entity gefuehrt. Ein Cast an jeder
	# Aufrufstelle waere Laerm ohne Erkenntnis.
	treatPhpDocTypesAsCertain: false

	ignoreErrors:
		# Der Markdown-Renderer haelt seinen Zustand (offene Liste, offenes
		# Zitat, gesammelter Absatz) in Variablen, die mehrere Closures per
		# Referenz teilen. PHPStan verfolgt Zuweisungen aus einer fremden
		# Closure nicht und haelt die Pruefungen deshalb fuer immer falsch -
		# sie sind es nicht, sonst kaeme aus dem Handbuch kein <ul> heraus.
		-
			identifier: if.alwaysFalse
			path: lib/Controller/HelpController.php
