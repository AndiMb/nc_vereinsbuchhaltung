includes:
	- .phpstan/vendor/phpstan/phpstan-deprecation-rules/rules.neon

# Statische Analyse des PHP-Anteils.
#
# Die Nextcloud-Server-Schnittstellen (OCP\*) liegen nicht im Repository. Sie
# werden fuer die Analyse als eigenes composer-Projekt unter .phpstan/ geholt
# (siehe .phpstan/composer.json und den CI-Schritt in .github/workflows/ci.yml).
# Bewusst getrennt von der composer.json der App: die bleibt ohne Abhaengigkeiten,
# damit im Release-Tarball kein Fremdcode landet.
#
# Lokal:  composer install --working-dir=.phpstan && npm run phpstan
#
# Das npm-Skript setzt --memory-limit=1G. PHPStan kennt dafuer keine
# neon-Einstellung (`parameters: memoryLimit` wird als unbekannter Schluessel
# abgewiesen), es geht nur ueber die Kommandozeile - deshalb hier als Skript
# festgehalten und nicht als Parameter weiter unten. Ohne das Limit erben die
# Parallel-Worker das php.ini-Limit (lokal 128M) und sterben mitten in der
# Analyse: PHPStan meldet dann 4 'Child process error'-Eintraege und den
# Hinweis 'Result is incomplete because of severe errors' - kein Befund am
# Code. In CI faellt das nicht auf, weil setup-php memory_limit=-1 setzt.
#
# Die Stubs (nextcloud/ocp) stehen auf ^33.0, der neuesten unterstuetzten
# Server-Version; appinfo/info.xml verlangt NC >=31. Die Stubs bestimmen nicht,
# welche Server die App laedt, aber sie zeigen, was in NC 33 als veraltet gilt.
# Dazu bindet diese Datei phpstan-deprecation-rules ein: Aufrufe veralteter
# Methoden/Klassen werden als `*.deprecated*`-Befund gemeldet.
#
# Der Befund aus Issue #2 (rund 205-206 argument.type-Fehler bei generischen
# DataResponse<T>) war ein PHPStan-eigener Regressionsbug in der
# Generics-Aufloesung (PHPStan 2.1.14 bis 2.2.1), kein Typproblem im Code.
# Behoben durch Pinnen von phpstan/phpstan auf ^2.2.5 in
# .phpstan/composer.json, per composer.lock reproduzierbar lokal wie in CI.
# Gegen die NC-33-Stubs tritt er mit PHPStan 2.3.4 nicht auf (0 argument.type).
# Fehlt dieser Pin oder faellt die Version darunter, kehrt er zurueck: dann
# nicht den Code aendern, sondern PHPStan aktualisieren.
parameters:
	level: 5
	paths:
		- lib
		- tests

	# Das ganze vendor-Verzeichnis, nicht nur nextcloud/ocp: psr/log kommt als
	# Abhaengigkeit der OCP-Stubs mit und wird von WatchFolderService gebraucht.
	scanDirectories:
		- .phpstan/vendor

	# Die Migrationen beschreiben einen vergangenen Zustand und werden nicht
	# mehr angefasst; ihre Schema-Closures sind fuer PHPStan ohnehin undurchsichtig.
	excludePaths:
		analyse:
			- lib/Migration

	# QBMapper::insert()/update() sind im Server generisch ueber @template
	# annotiert, in den Stubs aber nur als Entity gefuehrt. Ein Cast an jeder
	# Aufrufstelle waere Laerm ohne Erkenntnis.
	treatPhpDocTypesAsCertain: false

	# Bekannte Deprecations. Jeder Eintrag nennt die Aufgabe, die ihn abbaut;
	# wird er dort entfernt, meldet PHPStan unmatched ignores und erzwingt so
	# das Loeschen der Zeile. Neue Deprecations ausserhalb dieser Liste lassen
	# die Analyse scheitern.
	ignoreErrors:
		# IConfig::get/set/deleteAppValue, getAppKeys (seit NC 29: IAppConfig) und
		# get/set/deleteUserValue, getUserKeys (seit NC 33: IUserConfig).
		# Abbau: Task D2 (#262).
		-
			identifier: method.deprecated
			message: '#of interface OCP\\IConfig#'
		# IUserManager::search() (seit NC 27: searchDisplayName) und
		# IMailer::validateMailAddress() (seit NC 26: IEmailValidator::isValid).
		# Abbau: Task D4 (#262).
		-
			identifier: method.deprecated
			message: '#of interface OCP\\(IUserManager|Mail\\IMailer)#'
		# TCPDF ist als veraltet markiert (Nachfolger tecnickcom/tc-lib-pdf).
		# Eigenes Migrationsthema, nicht Teil von #262.
		-
			message: '#deprecated class TCPDF#'
		# chillerlan/php-qrcode 5: QROutputInterface::GDIMAGE_PNG ohne Ersatz.
		# EpcQrCodeGenerator; eigenes Thema, nicht Teil von #262.
		-
			identifier: classConstant.deprecated
			message: '#GDIMAGE_PNG#'
			path: lib/Service/EpcQrCodeGenerator.php
