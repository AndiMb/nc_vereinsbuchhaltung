/vendor/
/node_modules/
/js/
/build/
*.log
.DS_Store
.phpunit.cache/
.phpunit.result.cache
# Stubs fuer die statische Analyse (Nextcloud-Server-Schnittstellen, PHPUnit).
# composer.json und .lock dort sind versioniert - die Analyse soll auf jeder
# Maschine dieselben Stubs sehen. Das installierte vendor/ nicht: sonst laege
# Fremdcode im Repository und (ohne den rsync-Ausschluss) im Release-Tarball.
/.phpstan/vendor/
.phpstan-cache/
# Dasselbe Muster fuer die Formatpruefung (Nextcloud-Coding-Standard)
/.php-cs-fixer/vendor/
.php-cs-fixer.cache
# Playwright-E2E: Laufergebnisse und gecachte Anmeldezustaende
/playwright-report/
/test-results/
/tests/e2e/.auth/
# Rohmaterial fuer das README-Video u.ae. gehoert nicht ins Repo
*.mp3
# Erster, verworfener Videoanlauf: 90 MB Clips, Screenshots und Rohschnitte.
# Versioniert sind nur die Skripte der aktuellen Pipeline (docs/video-v3/),
# deren Ergebnisse liegen dort unter build/ und sind ebenfalls ausgenommen.
/docs/video/
# Lokales Composer-Binary - nicht versionieren
composer.phar
