<?xml version="1.0" encoding="UTF-8"?>
<!--
	Unit-Tests ohne laufende Nextcloud-Instanz. Den Schwerpunkt bilden Klassen
	ohne Nextcloud-Abhängigkeiten (Parser, Rechenlogik). Dazu kommen Klassen,
	deren OCP-Dienste sich als Schnittstelle mocken lassen – tests/bootstrap.php
	macht die OCP-Stubs dafür ladbar. Alles, was echte Nextcloud-Dienste braucht
	(Datenbank, Dateisystem, Sitzung), bleibt den E2E-Tests gegen eine laufende
	Instanz vorbehalten und ist hier bewusst nicht abgedeckt.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	colors="true"
	cacheDirectory=".phpunit.cache"
	failOnWarning="true"
	failOnRisky="true"
	failOnEmptyTestSuite="true">
	<testsuites>
		<testsuite name="unit">
			<directory>tests/unit</directory>
		</testsuite>
	</testsuites>
	<php>
		<!-- Die Bibliothek für E-Rechnungen lädt sehr große, erzeugte Klassen (E-Rechnungs-Tests); das
		     Standardlimit von 128 MB der PHP-CLI reicht dafür nicht. Nextcloud selbst läuft mit 512 MB. -->
		<ini name="memory_limit" value="1G"/>
	</php>
	<source>
		<include>
			<directory suffix=".php">lib</directory>
		</include>
	</source>
</phpunit>
